@page "/register"
@inject NavigationManager Nav
@inject AuthState Auth

<PageTitle>Register - Whisker List</PageTitle>

<!--
    No mockup was provided specifically for Register, so this mirrors the
    Login screen's new look (same card, same gold background, same logo
    placement) with a third field for confirming the password, so the two
    auth screens stay visually consistent.
-->
<div class="min-h-screen w-full bg-amber-400 relative flex items-center justify-center px-4">

    <img src="images/logo.png" alt="Whisker List logo" class="absolute top-6 left-6 w-16 h-16 object-contain" />

    <div class="w-full max-w-sm bg-white rounded-2xl shadow-xl p-8">
        <h1 class="font-['Playfair_Display'] italic font-bold text-3xl text-black text-center mb-6">
            REGISTER
        </h1>

        <EditForm Model="_model" OnValidSubmit="HandleRegister" class="flex flex-col gap-4">
            <DataAnnotationsValidator />

            <InputText @bind-Value="_model.Username" placeholder="Username"
                       class="w-full px-4 py-2 rounded-md border border-amber-300 bg-amber-50 text-black placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-400" />

            <InputText @bind-Value="_model.Password" type="password" placeholder="Password"
                       class="w-full px-4 py-2 rounded-md border border-amber-300 bg-amber-50 text-black placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-400" />

            <InputText @bind-Value="_model.ConfirmPassword" type="password" placeholder="Confirm password"
                       class="w-full px-4 py-2 rounded-md border border-amber-300 bg-amber-50 text-black placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-400" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="text-red-600 text-sm text-center">@_error</p>
            }

            <button type="submit"
                    class="w-full py-2 mt-2 bg-black text-white rounded-md font-semibold hover:bg-gray-800 transition-colors">
                Register
            </button>
        </EditForm>

        <p class="text-center text-sm text-gray-600 mt-4">
            Already have an account? <a href="login" class="text-black underline">Login</a>
        </p>
    </div>
</div>

@code {
    private readonly RegisterModel _model = new();
    private string? _error;

    private void HandleRegister()
    {
        var name = _model.Username?.Trim();
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(_model.Password))
        {
            _error = "Fill in a username and password.";
            return;
        }

        if (_model.Password != _model.ConfirmPassword)
        {
            _error = "Passwords don't match.";
            return;
        }

        // No real backend here - registering just starts a session,
        // same as logging in.
        _error = null;
        Auth.LogIn(name);
        Nav.NavigateTo("/dashboard");
    }

    private class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter a username.")]
        public string? Username { get; set; }

        public string? Password { get; set; }
        public string? ConfirmPassword { get; set; }
    }
}
