@page "/dashboard"
@inject ITaskService Tasks
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Dashboard - Whisker List</PageTitle>

@if (!Auth.IsLoggedIn)
{
    <p>Redirecting to login...</p>
}
else
{
    <!-- Page background: light gray, matching the mockup -->
    <div class="min-h-screen w-full bg-gray-100 flex">

        <!-- ===================== SIDEBAR ===================== -->
        <aside class="w-56 flex-shrink-0 bg-amber-400 flex flex-col">

            <!-- Same logo image as splash/login, just smaller here -->
            <div class="flex items-center justify-center py-8">
                <img src="images/logo.png" alt="Whisker List logo" class="w-16 h-16 object-contain"/>
            </div>

            <!-- Nav links. The active tab gets a white pill background;
                 everything else stays transparent on the gold sidebar. -->
            <nav class="flex flex-col gap-1 px-4">
                <button class="text-left px-4 py-2 rounded-md font-medium transition-colors @(_tab == Tab.Today ? "bg-white text-black" : "text-black/70 hover:bg-white/30")"
                        @onclick='() => _tab = Tab.Today'>
                    Today
                </button>
                <button class="text-left px-4 py-2 rounded-md font-medium transition-colors @(_tab == Tab.Write ? "bg-white text-black" : "text-black/70 hover:bg-white/30")"
                        @onclick='() => _tab = Tab.Write'>
                    Make Task
                </button>
                <button class="text-left px-4 py-2 rounded-md font-medium transition-colors @(_tab == Tab.Calendar ? "bg-white text-black" : "text-black/70 hover:bg-white/30")"
                        @onclick='() => _tab = Tab.Calendar'>
                    Calendar
                </button>
                <button class="text-left px-4 py-2 rounded-md font-medium transition-colors @(_tab == Tab.Profile ? "bg-white text-black" : "text-black/70 hover:bg-white/30")"
                        @onclick='() => _tab = Tab.Profile'>
                    Profile
                </button>
            </nav>

            <!-- mt-auto pushes this to the bottom of the sidebar -->
            <button class="mt-auto mb-6 mx-4 px-4 py-2 rounded-md font-medium text-black/70 hover:bg-white/30 transition-colors text-left"
                    @onclick="LogOut">
                Logout
            </button>
        </aside>

        <!-- ===================== MAIN CONTENT ===================== -->
        <main class="flex-1 p-10">
            <!-- White card floating on the gray page background -->
            <div class="bg-white rounded-2xl shadow-md p-8 max-w-4xl">

                @switch (_tab)
                {
                    case Tab.Today:
                        <h1 class="font-['Playfair_Display'] italic text-3xl mb-6">Welcome</h1>
                        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 mb-4">Tasks Today</h2>

                        @if (_loading)
                        {
                            <p class="text-gray-500 italic">Loading tasks...</p>
                        }
                        else if (!TodayTasks.Any())
                        {
                            <p class="text-gray-500">Nothing due today - head to "Make Task" to add one.</p>
                        }
                        else
                        {
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="text-xs uppercase tracking-wide text-gray-500 border-b border-gray-200">
                                        <th class="pb-2 font-medium">Task Name</th>
                                        <th class="pb-2 font-medium">Deadline</th>
                                        <th class="pb-2 font-medium">Status</th>
                                        <th class="pb-2"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var task in TodayTasks)
                                    {
                                        <!--
                                            Completed rows get dimmed via opacity-50, plus a
                                            grayed-out/strikethrough label. They end up at the
                                            bottom automatically because the TodayTasks property
                                            in the code block below sorts incomplete tasks
                                            before completed ones.
                                        -->
                                        <tr class="border-b border-gray-100 @(task.IsDone ? "opacity-50" : "")">
                                            <td class="py-3">
                                                <label class="flex items-center gap-3 cursor-pointer">
                                                    <input type="checkbox" checked="@task.IsDone"
                                                           @onchange="() => ToggleDone(task.Id)"
                                                           class="w-4 h-4 accent-amber-500" />
                                                    <span class="@(task.IsDone ? "line-through text-gray-400" : "text-black")">
                                                        @task.Title
                                                    </span>
                                                </label>
                                            </td>
                                            <td class="py-3 text-gray-600">@task.DueDate!.Value.ToString("MM/dd/yyyy")</td>
                                            <td class="py-3 text-gray-600">@(task.IsDone ? "Completed" : "Pending")</td>
                                            <td class="py-3 text-right">
                                                <button title="Delete task" @onclick="() => DeleteTask(task.Id)"
                                                        class="text-gray-400 hover:text-red-500 transition-colors">
                                                    ✕
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        break;

                    case Tab.Write:
                        <h1 class="font-['Playfair_Display'] italic text-3xl mb-6">Write Task</h1>
                        <EditForm Model="_newTask" OnValidSubmit="AddTask" class="flex flex-col gap-4 max-w-sm">
                            <DataAnnotationsValidator />
                            <label class="text-sm font-medium text-gray-600">Task name</label>
                            <InputText @bind-Value="_newTask.Title" placeholder="What needs doing?"
                                       class="w-full px-4 py-2 rounded-md border border-gray-200 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-amber-400" />
                            <ValidationMessage For="() => _newTask.Title" class="text-red-600 text-sm" />

                            <label class="text-sm font-medium text-gray-600">Due date</label>
                            <InputDate @bind-Value="_newTask.DueDate"
                                       class="w-full px-4 py-2 rounded-md border border-gray-200 bg-gray-50 focus:outline-none focus:ring-2 focus:ring-amber-400" />

                            <!--
                                Note: a task only shows up on the "Today" tab if its due
                                date is today's date, so leaving Due date blank (or picking
                                any other day) means the new task won't appear there - it
                                will still show up under Calendar, though.
                            -->
                            <button type="submit"
                                    class="w-full py-2 mt-2 bg-black text-white rounded-md font-semibold hover:bg-gray-800 transition-colors">
                                Add task
                            </button>
                        </EditForm>
                        break;

                    case Tab.Calendar:
                        <h1 class="font-['Playfair_Display'] italic text-3xl mb-6">Calendar</h1>
                        @if (_tasks.Any(t => t.DueDate is not null))
                        {
                            <ul class="flex flex-col gap-2">
                                @foreach (var task in _tasks.Where(t => t.DueDate is not null).OrderBy(t => t.DueDate))
                                {
                                    <li class="text-gray-700">
                                        <strong class="text-black">@task.DueDate!.Value.ToString("MMM d")</strong> - @task.Title
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-gray-500">No dated tasks yet.</p>
                        }
                        break;

                    case Tab.Profile:
                        <h1 class="font-['Playfair_Display'] italic text-3xl mb-6">Profile</h1>
                        <p class="text-gray-700">Logged in as <strong class="text-black">@Auth.CurrentUser</strong></p>
                        <p class="text-gray-700">@_tasks.Count(t => !t.IsDone) task(s) still pending.</p>
                        break;
                }
            </div>
        </main>
    </div>
}

@code {
    private enum Tab { Today, Write, Calendar, Profile }

    private Tab _tab = Tab.Today;
    private List<TaskItem> _tasks = new();
    private bool _loading = true;
    private NewTaskModel _newTask = new();

    // Only tasks due today appear on the "Today" tab (this is the filter
    // you asked for). Completed tasks are sorted to the end - OrderBy is a
    // stable sort, so ties (all the "not done" tasks, and separately all
    // the "done" ones) keep whatever order the task service returned them
    // in. Combined with the opacity/strikethrough styling in the markup
    // above, this gives the "check it -> turns gray and sinks to the
    // bottom" behavior.
    private IEnumerable<TaskItem> TodayTasks =>
        _tasks
            .Where(t => t.DueDate.HasValue && t.DueDate.Value.Date == DateTime.Today)
            .OrderBy(t => t.IsDone);

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        _loading = true;
        _tasks = await Tasks.GetTasksAsync();
        _loading = false;
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(_newTask.Title))
        {
            return;
        }

        await Tasks.AddTaskAsync(_newTask.Title.Trim(), TaskPriority.Medium, _newTask.DueDate, notes: null);
        _newTask = new NewTaskModel();
        _tab = Tab.Today;
        await LoadTasks();
    }

    private async Task ToggleDone(int id)
    {
        await Tasks.ToggleDoneAsync(id);
        // Reload so the sort order (incomplete first, completed last)
        // is recomputed immediately after the checkbox click.
        await LoadTasks();
    }

    private async Task DeleteTask(int id)
    {
        await Tasks.DeleteTaskAsync(id);
        await LoadTasks();
    }

    private void LogOut()
    {
        Auth.LogOut();
        Nav.NavigateTo("/login");
    }

    private class NewTaskModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Give the task a title.")]
        public string? Title { get; set; }

        public DateTime? DueDate { get; set; }
    }
}
